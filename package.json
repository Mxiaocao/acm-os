{
  "name": "acm-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:shells": "node --test scripts/startup-shells.test.mjs",
    "test:dom-shells": "node --test scripts/dom-shells.test.mjs",
    "test:reward-page": "node --test scripts/reward-page.test.mjs",
    "test:accessibility": "node --test scripts/accessibility-css.test.mjs",
    "test:visual-consistency": "node --test scripts/visual-consistency.test.mjs",
    "benchmark:performance": "node --experimental-strip-types scripts/performance-benchmark.ts",
    "benchmark:release-desktop": "node scripts/release-desktop-benchmark.mjs",
    "test:release-network": "cargo test --manifest-path src-tauri/Cargo.toml -p acm-os-infrastructure real_codeforces_ -- --ignored --test-threads=1",
    "test:desktop-e2e": "node scripts/desktop-e2e.mjs",
    "tauri": "tauri",
    "check:boundaries": "node --test scripts/check-boundaries.test.mjs && node scripts/check-boundaries.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "katex": "^0.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.11",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
